{
  "name": "astro-theme-bloggpt",
  "version": "0.1.0",
  "description": "An Astro blog theme inspired by ChatGPT's layout.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raincarnator/BlogGPT.git"
  },
  "homepage": "https://bloggpt.reincarnatey.net",
  "bugs": {
    "url": "https://github.com/Raincarnator/BlogGPT/issues"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "markdown",
    "mdx",
    "i18n"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "node scripts/prepare-build.mjs && astro check && astro build && node scripts/build-search.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "new": "node scripts/new.mjs",
    "starter:export": "node scripts/export-starter.mjs",
    "docs:dev": "pnpm --filter @bloggpt/docs dev",
    "docs:build": "pnpm --filter @bloggpt/docs build",
    "docs:preview": "pnpm --filter @bloggpt/docs preview",
    "build:all": "pnpm build && pnpm docs:build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@iconify-json/lucide": "^1.2.143",
    "@iconify-json/simple-icons": "^1.2.100",
    "@tailwindcss/typography": "^0.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.8",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.1.5",
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "pagefind": "1.5.2",
    "parse5": "^8.0.1",
    "photoswipe": "^5.4.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.56.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.31",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "license": "Apache-2.0"
}
