---
interface Props {
  id: string;
  label: string;
  class?: string;
  triggerClass?: string;
  panelClass?: string;
  align?: 'start' | 'end';
  side?: 'bottom' | 'right';
  width?: number;
  tooltip?: string;
}
const {
  id,
  label,
  class: className,
  triggerClass,
  panelClass,
  align = 'start',
  side = 'bottom',
  width = 224,
  tooltip,
} = Astro.props;
---

<div class:list={['popover-root', className]} data-popover-root>
  <button
    id={`${id}-trigger`}
    type="button"
    class:list={['popover-trigger', triggerClass]}
    popovertarget={id}
    aria-label={label}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={id}
    data-popover-trigger
    data-tooltip={tooltip}
  >
    <slot name="trigger" />
  </button>
  <div
    id={id}
    popover="auto"
    role="menu"
    aria-labelledby={`${id}-trigger`}
    class:list={['popover-panel', panelClass]}
    style={`--popover-width: ${width}px`}
    data-popover-align={align}
    data-popover-side={side}
  >
    <slot />
  </div>
</div>
