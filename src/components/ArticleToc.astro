---
import { t } from '../lib/i18n';
import type { MarkdownHeading } from 'astro';
import type { Locale } from '../types/config';
import config from '../lib/config';
import ThemeIcon from './ThemeIcon.astro';
interface Props {
  headings: MarkdownHeading[];
  lang: Locale;
}
const { headings, lang } = Astro.props;
const ui = t(lang);
const options = config.article.toc;
const entries = headings.filter(
  (heading) =>
    heading.depth >= options.minDepth && heading.depth <= options.maxDepth,
);
const title = ui.articleToc;
---

{entries.length > 0 && (
  <aside
    class="article-toc"
    data-article-toc
    data-delay={options.expandDelay}
    data-hide-delay={options.hideDelay ?? 800}
  >
    <nav class="toc-rail" aria-label={title} data-toc-rail>
      {entries.map((heading) => (
        <a
          draggable="false"
          href={`#${heading.slug}`}
          aria-label={heading.text}
          data-toc-entry={heading.slug}
          data-title={heading.text}
          style={`--toc-line-width:${Math.max(6, 24 - (heading.depth - options.minDepth) * 7)}px`}
        >
          <span></span>
        </a>
      ))}
    </nav>
    <div
      id="article-toc-panel"
      class="toc-panel"
      popover="manual"
      data-toc-panel
    >
      <div data-toc-preview>
        <strong data-toc-title></strong>
        <p data-toc-excerpt></p>
        <button type="button" data-toc-expand>
          {ui.showToc}
        </button>
      </div>
      <nav data-toc-full aria-label={title} hidden>
        <div class="toc-panel-heading">
          <strong>{title}</strong>
          <button type="button" data-toc-close aria-label={ui.close}>
            <ThemeIcon name="x" size={18} />
          </button>
        </div>
        <div class="toc-items" data-toc-items>
          <div
            class="toc-visible-range"
            data-toc-visible-range
            aria-hidden="true"
            hidden
          ></div>
          {entries.map((heading) => (
            <a
              draggable="false"
              href={`#${heading.slug}`}
              data-toc-entry={heading.slug}
              style={`--toc-indent:${(heading.depth - options.minDepth) * 14}px`}
            >
              {heading.text}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </aside>
)}
<script>
  import '../scripts/article-toc';
</script>
