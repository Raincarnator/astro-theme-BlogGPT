---
import { formatMessage } from '../lib/translations';
import config from '../lib/config';
import { discoverablePosts } from '../lib/content';
import { characterCount, footerPeriod } from '../lib/footer';
import { localize, t } from '../lib/i18n';
import type { Locale } from '../types/config';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const ui = t(lang);
const posts = await discoverablePosts(lang);
const period = footerPeriod(
  config.footer.since,
  new Date(),
  config.site.timezone,
);
const characters = posts.reduce(
  (sum, post) => sum + characterCount(post.body ?? ''),
  0,
);
const words = new Intl.NumberFormat(lang, {
  notation: 'compact',
  maximumFractionDigits: 1,
})
  .format(characters)
  .toLowerCase();
---

<footer class="site-footer" data-pagefind-ignore>
  <p class="footer-summary">
    © {period.years}{' '}
    {localize(config.footer.author, lang) || localize(config.author.name, lang)}{' '}
    ·{' '}
    {formatMessage(ui.footerSummary, {
      days: period.days.toLocaleString(lang),
      words,
      posts: posts.length.toLocaleString(lang),
    })}
  </p>
  <p class="footer-description">
    {localize(config.text.footerDescription, lang)}
  </p>
  <p class="footer-license">
    {config.footer.showAttribution && (
      <>
        <span class="footer-attribution">
          Powered by{' '}
          <a
            href="https://astro.build/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Astro
          </a>{' '}
          &amp;{' '}
          <a
            href="https://bloggpt.reincarnatey.net"
            target="_blank"
            rel="noopener noreferrer"
          >
            BlogGPT
          </a>
        </span>{' '}
        ·{' '}
      </>
    )}
    © Licensed under{' '}
    <a
      href={config.footer.license.url}
      target="_blank"
      rel="noopener noreferrer"
    >
      {config.footer.license.label}
    </a>
  </p>
</footer>
