---
import ThemeIcon from './ThemeIcon.astro';
interface Props {
  title: string;
  description?: string;
  eyebrow: string;
  icon: string;
}
const { title, description, eyebrow, icon } = Astro.props;
---

<header class="page-heading">
  <div class="eyebrow">
    <ThemeIcon name={icon} size={17} />
    {eyebrow}
  </div>
  <h1>{title}</h1>
  {description && <p>{description}</p>}
</header>
