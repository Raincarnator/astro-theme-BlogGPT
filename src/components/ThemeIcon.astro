---
import { Icon } from 'astro-icon/components';
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const iconName = name.includes(':') ? name : `lucide:${name}`;
---

<Icon
  name={iconName}
  size={size}
  class:list={['theme-icon', className]}
  is:inline
  aria-hidden="true"
/>
