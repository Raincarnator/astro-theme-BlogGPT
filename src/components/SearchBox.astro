---
import ThemeIcon from './ThemeIcon.astro';
import ComposerSuggestions from './ComposerSuggestions.astro';
import config from '../lib/config';
import SearchScope from './SearchScope.astro';
import { t, href, localize } from '../lib/i18n';
import type { Locale } from '../types/config';
import { discoverablePosts, postHref } from '../lib/content';
interface Props {
  lang: Locale;
  value?: string;
  compact?: boolean;
  home?: boolean;
}
const { lang, value = '', compact = false, home = false } = Astro.props;
const ui = t(lang);
const recentPosts = home
  ? (await discoverablePosts(lang))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, config.posts.randomLimit)
  : [];
const recentUrls = recentPosts.map((post) => postHref(post, lang));
---

<form
  class:list={['search-composer', { compact, 'home-composer': home }]}
  action={href(lang, 'search/')}
  role="search"
  data-search-form
>
  {home ? (
    <button
      type="button"
      class="icon-button composer-plus"
      aria-label={ui.browse}
      data-completion-toggle
      aria-controls="suggestions-home"
      aria-expanded="false"
      aria-haspopup="listbox"
    >
      <ThemeIcon name="plus" size={24} class="composer-plus-icon" />
    </button>
  ) : (
    <ThemeIcon name="search" size={22} />
  )}
  <input
    type="search"
    name="q"
    value={value}
    aria-label={ui.search}
    placeholder={localize(config.text.searchPlaceholder, lang)}
    autocomplete="off"
  />
  {home ? (
    <>
      <SearchScope lang={lang} id="scope-home" />
      <a
        class="icon-button composer-random"
        href={recentUrls[0] ?? href(lang, 'posts/')}
        data-random-posts={JSON.stringify(recentUrls)}
        aria-label={ui.randomRecent}
        data-tooltip={ui.randomRecent}
      >
        <ThemeIcon name="shuffle" />
      </a>
    </>
  ) : (
    <SearchScope lang={lang} id="scope-results" />
  )}
  <ComposerSuggestions
    lang={lang}
    id={home ? 'suggestions-home' : 'suggestions-results'}
  />
  <button
    class="send-button"
    type="submit"
    aria-label={ui.search}
    data-tooltip={ui.search}
    data-query-button={home ? true : undefined}
    data-has-query={home ? String(Boolean(value.trim())) : undefined}
  >
    {home && (
      <span class="empty-query-icon">
        <ThemeIcon name="search" size={20} />
      </span>
    )}
    <span class="filled-query-icon">
      <ThemeIcon name="arrow-up" size={20} />
    </span>
  </button>
</form>
