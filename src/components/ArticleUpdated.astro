---
import { t, dateLabel } from '../lib/i18n';
import type { Locale } from '../types/config';
interface Props {
  lang: Locale;
  date?: Date;
  updated?: Date;
}
const { lang, date, updated } = Astro.props;
---

{updated && updated.getTime() !== date?.getTime() && (
  <span class="article-updated">
    {t(lang).updated}{' '}
    <time datetime={updated.toISOString()}>{dateLabel(updated, lang)}</time>
  </span>
)}
