---
import { localeInfo } from '../lib/translations';
import { contentImage } from '../lib/content-image';
import type { Post } from '../lib/content';
import {
  postHref,
  readingMinutes,
  taxonomyLabels,
  encodedSlug,
} from '../lib/content';
import { t, href, dateLabel } from '../lib/i18n';
import type { Locale } from '../types/config';
import ThemeIcon from './ThemeIcon.astro';
interface Props {
  posts: Post[];
  lang: Locale;
  compact?: boolean;
}
const { posts, lang, compact = false } = Astro.props;
const ui = t(lang);
const labels = await taxonomyLabels(lang);
---

<div class:list={['post-list', { compact }]}>
  {posts.length === 0 && <p class="empty-state">{ui.noPosts}</p>}
  {posts.map((post) => (
    <article
      class:list={['post-row', { 'has-cover': Boolean(post.data.image) }]}
    >
      <div class="post-row-copy">
        <div class="post-row-meta">
          {post.data.featured && (
            <span class="pin-label">
              <ThemeIcon name="pin" size={13} />
              {ui.featured}
            </span>
          )}
          <time datetime={post.data.date.toISOString()}>
            {dateLabel(post.data.date, lang)}
          </time>
          {post.data.categories[0] && (
            <>
              <span>·</span>
              <a
                href={href(
                  lang,
                  `categories/${encodedSlug(post.data.categories[0])}/`,
                )}
              >
                {labels.categories[post.data.categories[0]] ??
                  post.data.categories[0]}
              </a>
            </>
          )}
          {post.data.draft && <span class="status-label">{ui.draft}</span>}
          {post.data._locale && post.data._locale !== lang && (
            <span class="status-label">{localeInfo(post.data.lang).label}</span>
          )}
        </div>
        <a class="post-row-title" href={postHref(post, lang)}>
          <h3>{post.data.title}</h3>
          {!post.data.image && <ThemeIcon name="arrow-up-right" size={19} />}
        </a>
        {post.data.description && (
          <p class="post-description">{post.data.description}</p>
        )}
      </div>
      {post.data.image && (
        <a
          class="post-row-cover"
          href={postHref(post, lang)}
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src={contentImage(post.data.image, postHref(post, lang))}
            alt=""
            width="240"
            height="160"
            loading="lazy"
          />
        </a>
      )}
      {!compact && (
        <div class="post-bottom">
          <span>
            {readingMinutes(post)} {ui.minutes}
          </span>
          <div>
            {post.data.tags.map((tag) => (
              <a class="tag" href={href(lang, `tags/${encodedSlug(tag)}/`)}>
                {labels.tags[tag] ?? tag}
              </a>
            ))}
          </div>
        </div>
      )}
    </article>
  ))}
</div>
