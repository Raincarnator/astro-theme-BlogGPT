---
import { postHref, type Post } from '../lib/content';
import { dateLabel, t } from '../lib/i18n';
import type { Locale } from '../types/config';
interface Props {
  entries: { post: Post; words: number }[];
  lang: Locale;
}
const { entries, lang } = Astro.props;
const ui = t(lang);
---

<ul class="statistics-detail-entries">
  {entries.map(({ post, words }) => (
    <li>
      <a href={postHref(post, lang)}>{post.data.title}</a>
      {post.data.description && <p>{post.data.description}</p>}
      <small>
        {dateLabel(post.data.date, lang)} · {words.toLocaleString(lang)}{' '}
        {ui.characters}
      </small>
    </li>
  ))}
</ul>
