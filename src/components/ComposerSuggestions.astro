---
import { t } from '../lib/i18n';
import { formatMessage } from '../lib/translations';
import config from '../lib/config';
import { commands } from '../lib/commands';
import { discoverablePosts } from '../lib/content';
import ThemeIcon from './ThemeIcon.astro';
import type { Locale } from '../types/config';
interface Props {
  lang: Locale;
  id: string;
}
const { lang, id } = Astro.props;
const ui = t(lang);
const recent = (await discoverablePosts(lang))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, config.posts.menuLimit);
---

<div
  id={id}
  popover="manual"
  role="listbox"
  aria-label={ui.completionLabel}
  class="popover-panel composer-shortcuts-menu"
  data-completion-panel
>
  <div class="composer-menu-scroll" data-completion-list>
    {commands
      .filter(
        (command) =>
          command.name !== 'status' || config.statistics?.enabled !== false,
      )
      .map((command) => (
        <button
          type="button"
          role="option"
          aria-selected="false"
          data-completion-value={`/${command.name}`}
          data-completion-name={command.name}
        >
          <ThemeIcon name={command.icon} size={20} />
          <span>/{command.name}</span>
          <small>
            {formatMessage(
              ui[
                (
                  {
                    random: 'commandRandom',
                    lang: 'commandLang',
                    theme: 'commandTheme',
                    status: 'commandStatus',
                    categories: 'commandCategories',
                    archives: 'commandArchives',
                  } as const
                )[command.name]
              ],
              { locales: config.site.locales.join(' / ') },
            )}
          </small>
        </button>
      ))}
    {recent.map((post) => (
      <button
        type="button"
        role="option"
        aria-selected="false"
        data-completion-value={`@${post.data.title}`}
      >
        <ThemeIcon name="message-circle" size={20} />
        <span>{post.data.title}</span>
      </button>
    ))}
  </div>
</div>
