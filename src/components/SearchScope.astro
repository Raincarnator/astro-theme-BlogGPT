---
import { t } from '../lib/i18n';
import Popover from './Popover.astro';
import ThemeIcon from './ThemeIcon.astro';
import { searchScopes } from '../lib/search';
import type { Locale } from '../types/config';
interface Props {
  lang: Locale;
  id: string;
}
const { lang, id } = Astro.props;
const ui = t(lang);
const labels = {
  all: ui.scopeAll,
  articles: ui.scopeArticles,
  title: ui.scopeTitle,
  body: ui.scopeBody,
};
---

<input type="hidden" name="scope" value="articles" />
<Popover
  id={id}
  label={ui.searchScope}
  class="composer-options composer-scope"
  triggerClass="scope-button"
  panelClass="composer-menu"
  align="end"
>
  <Fragment slot="trigger">
    <span data-scope-label>{labels.articles}</span>
    <ThemeIcon name="chevron-down" size={18} />
  </Fragment>
  {searchScopes.map((scope) => (
    <button
      type="button"
      role="menuitemradio"
      aria-checked={scope === 'articles' ? 'true' : 'false'}
      data-search-scope={scope}
      data-scope-text={labels[scope]}
    >
      <ThemeIcon
        name={
          scope === 'all'
            ? 'globe'
            : scope === 'articles'
              ? 'files'
              : scope === 'title'
                ? 'heading'
                : 'text'
        }
      />
      {labels[scope]}
      <ThemeIcon name="check" class="menu-check" size={16} />
    </button>
  ))}
</Popover>
