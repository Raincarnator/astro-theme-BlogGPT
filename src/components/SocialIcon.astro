---
import ThemeIcon from './ThemeIcon.astro';
interface Props {
  name: string;
  size?: number;
}
const { name, size = 18 } = Astro.props;
// Brand names default to Simple Icons. Generic actions, e.g. email, explicitly use lucide:mail.
const icon = name.includes(':') ? name : `simple-icons:${name}`;
---

<ThemeIcon name={icon} size={size} />
