---
import { render } from 'astro:content';
import type { TextEntry } from '../lib/content';
import { contentImage } from '../lib/content-image';
import config from '../lib/config';
import katexStyles from 'katex/dist/katex.min.css?url';
import { articleFeatures } from '../lib/article-options';
interface Props {
  entry?: TextEntry;
  showCover?: boolean;
  indexContent?: boolean;
}
const { entry, showCover = true, indexContent = true } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const image = contentImage(entry?.data.image, Astro.url.pathname);
const features = articleFeatures(entry?.data ?? {}, config.article);
---

{entry && (
  <section
    class="content-intro"
    aria-label={entry.data.title}
    data-search-record={
      indexContent && !entry.data.hidden && !entry.data.draft
        ? entry.collection
        : undefined
    }
    data-search-title={entry.data.title}
    data-search-description={entry.data.description}
  >
    {features.math && !config.article.math && (
      <link rel="stylesheet" href={katexStyles} />
    )}
    {showCover && image && (
      <img class="article-cover" src={image} alt="" width="960" height="400" />
    )}
    {Content && (
      <div
        class="article-content prose"
        data-search-content
        data-mermaid={String(features.mermaid)}
        data-lightbox={String(features.lightbox)}
      >
        <Content />
      </div>
    )}
  </section>
)}
