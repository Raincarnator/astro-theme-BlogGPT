---
import OverflowTitle from './OverflowTitle.astro';
import ThemeIcon from './ThemeIcon.astro';
import { localize } from '../lib/i18n';
import { navigationHref } from '../lib/navigation';
import type { Locale, SidebarItem } from '../types/config';
interface Props {
  item: SidebarItem;
  lang: Locale;
  active?: string;
}
const { item, lang, active } = Astro.props;
const target = await navigationHref(item, lang);
---

<a
  class:list={['nav-item', { active: active === item.id }]}
  href={target}
  target={item.type === 'external' && item.newTab ? '_blank' : undefined}
  rel={item.type === 'external' ? 'noopener noreferrer' : undefined}
  aria-current={active === item.id ? 'page' : undefined}
  data-tooltip={
    item.type === 'builtin' && item.route === 'home'
      ? localize(item.label, lang)
      : undefined
  }
  data-tooltip-shortcut={
    item.type === 'builtin' && item.route === 'home'
      ? 'Ctrl+Shift+O'
      : undefined
  }
>
  <span class="sidebar-icon-slot">
    <ThemeIcon name={item.icon} size={18} />
  </span>
  <OverflowTitle class="nav-label" title={localize(item.label, lang)} />
  {item.type === 'external' && (
    <ThemeIcon name="external-link" size={14} class="nav-external" />
  )}
</a>
