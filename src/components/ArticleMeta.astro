---
import config from '../lib/config';
import { t, dateLabel, withBase, localize } from '../lib/i18n';
import { readingMinutes } from '../lib/content';
import type { ArticleDisplay, Locale } from '../types/config';
interface Props {
  lang: Locale;
  entry: { body?: string; data: { date?: Date; updated?: Date } };
  display: ArticleDisplay;
}
const { lang, entry, display } = Astro.props;
const ui = t(lang);
const avatar = /^(https?:|data:)/.test(config.author.avatar)
  ? config.author.avatar
  : withBase(config.author.avatar);
---

{(display.author ||
  (display.published && entry.data.date) ||
  display.readingTime) && (
  <div class="article-meta" data-pagefind-ignore>
    {display.author && (
      <span class="article-author">
        <img src={avatar} alt="" width="22" height="22" />
        {localize(config.author.name, lang)}
      </span>
    )}
    {display.published && entry.data.date && (
      <time datetime={entry.data.date.toISOString()}>
        {dateLabel(entry.data.date, lang)}
      </time>
    )}
    {display.readingTime && (
      <span>
        {readingMinutes(entry)} {ui.minutes}
      </span>
    )}
  </div>
)}
