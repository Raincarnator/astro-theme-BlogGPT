---
import config from '../lib/config';
import Layout from '../layouts/Layout.astro';
import { t, href, localize } from '../lib/i18n';
const lang = config.site.defaultLocale;
const ui = t(lang);
---

<Layout lang={lang} title="404" noindex alternatePaths={{}}>
  <div class="content-column not-found">
    <p class="error-code">404</p>
    <h1>{localize(config.text.notFoundMessage, lang)}</h1>
    <a href={href(lang)}>{ui.back}</a>
  </div>
</Layout>
