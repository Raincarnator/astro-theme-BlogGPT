---
import { pageLocale, routeLocales } from '../../../../lib/i18n';
import config from '../../../../lib/config';
import PostIndex from '../../../../components/PostIndex.astro';
import { postsFor } from '../../../../lib/content';
export async function getStaticPaths({
  routePattern,
}: import('astro').GetStaticPathsOptions) {
  const paths = [];
  for (const lang of routeLocales(routePattern)) {
    const count = Math.ceil(
      (await postsFor(lang)).length / Math.max(1, config.posts.perPage),
    );
    for (let page = 2; page <= count; page++)
      paths.push({ params: { page: String(page) } });
  }
  return paths;
}
const lang = pageLocale(Astro.routePattern);
---

<PostIndex lang={lang} page={Number(Astro.params.page)} />
