---
import { pageLocale } from '../../lib/i18n';
import friends from '../../lib/friends';
import ContentIntro from '../../components/ContentIntro.astro';
import { introFor } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import ThemeIcon from '../../components/ThemeIcon.astro';
import BuiltinHeading from '../../components/BuiltinHeading.astro';
import { t, localize, withBase } from '../../lib/i18n';
const lang = pageLocale(Astro.routePattern);
const ui = t(lang);
const intro = await introFor('links', lang);
const title = intro?.data.title ?? ui.links;
---

<Layout
  lang={lang}
  title={title}
  description={intro?.data.description}
  active="links"
>
  <div class="content-column friends-directory" data-friends-directory>
    <BuiltinHeading
      title={title}
      description={intro?.data.description}
      eyebrow={ui.links}
      icon="link"
    />
    <ContentIntro entry={intro} />
    <label class="friends-search">
      <ThemeIcon name="search" size={16} />
      <input
        type="search"
        data-friends-search
        aria-label={ui.searchFriends}
        placeholder={ui.searchFriends}
        autocomplete="off"
      />
    </label>
    {friends.map((group) => (
      <section class="friend-group" data-friend-group>
        <h2>{localize(group.title, lang)}</h2>
        {group.description && <p>{localize(group.description, lang)}</p>}
        <div class="friend-grid">
          {group.links.map((link) => (
            <a
              class="friend-card"
              data-friend-card
              data-search-text={`${localize(link.name, lang)} ${localize(link.description, lang)} ${localize(group.title, lang)}`}
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.avatar ? (
                <img
                  class="friend-avatar"
                  src={
                    /^https?:/.test(link.avatar)
                      ? link.avatar
                      : withBase(link.avatar)
                  }
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="friend-avatar">
                  <ThemeIcon name={link.icon ?? 'globe'} size={23} />
                </span>
              )}
              <div class="friend-info">
                <h3>{localize(link.name, lang)}</h3>
                <p>{localize(link.description, lang)}</p>
              </div>
              <span class="friend-visit">
                <ThemeIcon name="arrow-up-right" size={18} />
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="friends-empty" data-friends-empty role="status" hidden>
      {ui.noFriends}
    </p>
  </div>
</Layout>
