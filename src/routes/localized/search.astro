---
import { pageLocale } from '../../lib/i18n';
import config from '../../lib/config';
import Layout from '../../layouts/Layout.astro';
import SearchBox from '../../components/SearchBox.astro';
import ThemeIcon from '../../components/ThemeIcon.astro';
import { t, localize } from '../../lib/i18n';
const lang = pageLocale(Astro.routePattern);
const ui = t(lang);
const heading = localize(config.text.searchHeading, lang);
---

<Layout lang={lang} title={ui.search} noindex>
  <div class="content-column search-page">
    <header class="page-heading">
      <div class="eyebrow">
        <ThemeIcon name="search" size={17} />
        {ui.search}
      </div>
      <h1>{heading}</h1>
      <SearchBox lang={lang} />
    </header>
    <div class="search-output" data-search-output aria-live="polite">
      <p class="search-hint">{heading}</p>
    </div>
  </div>
</Layout>
