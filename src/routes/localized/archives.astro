---
import { pageLocale } from '../../lib/i18n';
import config from '../../lib/config';
import ContentIntro from '../../components/ContentIntro.astro';
import { introFor } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import BuiltinHeading from '../../components/BuiltinHeading.astro';
import { postsFor, postHref, type Post } from '../../lib/content';
import { t, dateLabel } from '../../lib/i18n';
const lang = pageLocale(Astro.routePattern);
const ui = t(lang);
const intro = await introFor('archives', lang);
const title = intro?.data.title ?? ui.archiveTitle;
const posts = (await postsFor(lang)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const groups = new Map<string, Post[]>();
for (const post of posts) {
  const year = new Intl.DateTimeFormat('en', {
    year: 'numeric',
    timeZone: config.site.timezone,
  }).format(post.data.date);
  groups.set(year, [...(groups.get(year) ?? []), post]);
}
---

<Layout
  lang={lang}
  title={title}
  description={intro?.data.description}
  active="archives"
>
  <div class="content-column">
    <BuiltinHeading
      title={title}
      description={
        intro?.data.description ?? `${posts.length} ${ui.articleCount}`
      }
      eyebrow={ui.archives}
      icon="archive"
    />
    <ContentIntro entry={intro} />
    {[...groups].map(([year, articles]) => (
      <section class="archive-year" id={year}>
        <h2>
          {year}
          <span>
            {articles.length} {ui.articleCount}
          </span>
        </h2>
        {articles.map((post) => (
          <div class="archive-row">
            <time datetime={post.data.date.toISOString()}>
              {dateLabel(post.data.date, lang)
                .replace(year, '')
                .replace(/年|,\s*$/g, '')}
            </time>
            <a href={postHref(post, lang)}>{post.data.title}</a>
          </div>
        ))}
      </section>
    ))}
  </div>
</Layout>
