---
import { localeInfo } from '../lib/translations';
import config from '../lib/config';
import { href, localize } from '../lib/i18n';
import { htmlRoutes } from '../lib/html-routes';
export async function getStaticPaths() {
  const prefix = href(config.site.defaultLocale);
  return (await htmlRoutes(config.site.defaultLocale)).map((target) => ({
    params: {
      unprefixed:
        decodeURI(target.slice(prefix.length)).replace(/\/$/, '') || undefined,
    },
    props: { target },
  }));
}
interface Props {
  target: string;
}
const { target } = Astro.props;
---

<!doctype html>
<html lang={localeInfo(config.site.defaultLocale).lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>{localize(config.site.title, config.site.defaultLocale)}</title>
    <link rel="canonical" href={new URL(target, config.site.url).href} />
    <script is:inline define:vars={{ target }}>
      // Retain search queries and paragraph fragments when JavaScript is available.
      if (location.search || location.hash)
        location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <a href={target}>
      {localize(config.site.title, config.site.defaultLocale)}
    </a>
  </body>
</html>
